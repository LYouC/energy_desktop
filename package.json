{
  "name": "xixu-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "pack": "install-electron && npm run build && electron-builder --win dir --config.electronDist=node_modules/electron/dist",
    "pack:installer": "install-electron && npm run build && electron-builder --win nsis --x64 --publish never --config.electronDist=node_modules/electron/dist",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs && node tests/review.desktop.mjs && node tests/agent-ui.desktop.mjs && node tests/agent-context.desktop.mjs && node tests/today.desktop.mjs && node tests/task-fields.desktop.mjs && node tests/recurrence.desktop.mjs",
    "test:agent:live": "node --import tsx tests/agent.live.ts",
    "test:agent:journey": "node --import tsx tests/agent-journey.live.ts",
    "test:agent:behavior": "node --import tsx tests/agent-behavior.live.ts",
    "format:check": "prettier --check src tests vite.config.ts",
    "format": "prettier --write src tests vite.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.24",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vue-tsc": "^3.1.4"
  },
  "build": {
    "appId": "local.xixu.desktop",
    "productName": "息序",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "xixu-${version}-windows-${arch}-setup.${ext}"
    }
  },
  "overrides": {
    "minimatch": "^11.0.2"
  },
  "description": "息序个人桌面任务规划原型",
  "engines": {
    "node": ">=24.0.0"
  }
}
